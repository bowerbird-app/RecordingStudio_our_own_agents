<%# Delete this override once Admin 2.5.2 and core 6.3 are pinned. %>
<% if screen.chart %>
  <% summary = screen.summary %>
  <% metric_count = summary&.value || screen.query_result.count %>
  <% metric_change = summary&.show_change ? summary.change : nil %>
  <% metric_period_label = summary&.show_period ? summary.period_label : nil %>
  <% change_tone = RecordingStudioAdmin::WidgetChangeSemantics.tone(
    change: metric_change,
    good_when: summary&.change_good_when || :up
  ) %>
  <% change_text_class = case change_tone
                         when :success
                           "text-[var(--color-success-background-color)]"
                         when :danger
                           "text-[var(--color-danger-background-color)]"
                         else
                           "text-[var(--surface-muted-content-color)]"
                         end %>

    <%= render FlatPack::Card::Component.new(border: :strong, class: "mb-6") do |card| %>
      <% card.body do %>
        <% if screen.chart.title.present? %>
          <div class="mb-4 flex items-start gap-4">
            <% if summary.nil? || summary.show_metric %>
              <div class="shrink-0">
                <%= render FlatPack::Heading::Component.new(text: metric_count.to_s, level: :h3, size: :"5xl", weight: :bold) %>
              </div>
            <% end %>

            <div class="min-w-0 flex-1 space-y-1 text-left">
              <% if screen.chart.title.present? %>
                <%= render FlatPack::Heading::Component.new(text: screen.chart.title, level: :h3, size: :lg, weight: :semibold) %>
              <% end %>

              <% if metric_change.present? || metric_period_label.present? %>
                <%= render FlatPack::Cluster::Component.new(gap: :sm, align: :center) do %>
                  <% if metric_change.present? %>
                    <%= render FlatPack::Text::Component.new(text: metric_change.to_s, as: :span, size: :sm, weight: :semibold, class: change_text_class) %>
                  <% end %>
                  <% if metric_period_label.present? %>
                    <%= render FlatPack::Text::Component.new(text: metric_period_label, as: :span, size: :sm, weight: :semibold, style: :muted) %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% screen_chart_options = (screen.chart.options || {}) %>

        <% screen_chart_type = RecordingStudioAdmin::Widgets::Presenter.renderable_chart_type(screen.chart.type, default: :line) %>
        <% screen_chart_series = screen_chart_type == :geochart ? recording_studio_flatpack_geochart_series(screen.chart.series) : screen.chart.series %>
        <% screen_chart_render_options = screen_chart_type == :geochart ? recording_studio_flatpack_geochart_options(screen_chart_options) : screen_chart_options %>

        <%= render FlatPack::Chart::Component.new(
          type: screen_chart_type,
          series: screen_chart_series,
          options: screen_chart_render_options,
          card: false
        ) %>
      <% end %>
    <% end %>
<% end %>
