<%# Delete this override once Admin 2.5.2 and core 6.3 are pinned. %>
<% presenter ||= recording_studio_widget_presenter(widget) %>
<% compact_card = presenter.compact? %>
<% placeholder_height = if compact_card
                          "min-h-28 max-h-28"
                            elsif widget.type == :chart
                              "min-h-[22rem]"
                            elsif widget.type == :list
                              "min-h-[15rem]"
                            else
                              "min-h-[11rem]"
                            end %>

<%= render FlatPack::Card::Component.new(border: :strong, class: "w-full #{placeholder_height}") do |card| %>
  <% card.body do %>
    <div class="flex <%= compact_card ? "h-full" : placeholder_height %> flex-col space-y-3" aria-busy="true">
      <% if compact_card %>
        <div class="flex flex-1 items-start gap-3">
          <div class="min-w-0 flex-1 space-y-2">
            <% if widget.title.present? %>
              <%= render FlatPack::Heading::Component.new(text: widget.title, level: :h3, size: :lg, weight: :semibold) %>
            <% end %>
            <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "66%", shimmer: true) %>
            <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "50%", shimmer: true) %>
          </div>

          <% if widget.type == :chart %>
            <div class="h-14 w-[104px] min-w-[104px]">
              <%= render FlatPack::Skeleton::Component.new(variant: :rectangle, width: "104px", height: "3.5rem", shimmer: true) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <% if widget.title.present? %>
          <%= render FlatPack::Heading::Component.new(text: widget.title, level: :h3, size: :xl, weight: :semibold) %>
        <% end %>

        <% if widget.subtitle.present? && widget.type != :progress %>
          <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "50%", shimmer: true) %>
        <% end %>

        <% case widget.type %>
        <% when :chart %>
          <div class="mt-2 min-h-64 flex-1">
            <%= render FlatPack::Skeleton::Component.new(variant: :rectangle, height: "16rem", shimmer: true) %>
          </div>
        <% when :list %>
          <%= render FlatPack::Stack::Component.new(gap: :sm, class: "pt-2") do %>
            <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "83%", shimmer: true) %>
            <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "66%", shimmer: true) %>
            <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "75%", shimmer: true) %>
            <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "50%", shimmer: true) %>
          <% end %>
        <% when :progress %>
          <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "50%", shimmer: true) %>
          <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "100%", shimmer: true) %>
          <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "33%", shimmer: true) %>
        <% else %>
          <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "50%", shimmer: true) %>
          <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "66%", shimmer: true) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>