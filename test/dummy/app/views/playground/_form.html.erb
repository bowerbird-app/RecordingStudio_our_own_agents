<%= form_with url: playground_path, method: :post, data: {
  controller: "playground-agent",
  action: "change->playground-agent#change",
  playground_agent_profiles_value: @catalog.to_h { |entry| [entry.token, entry.profile.to_s] }.to_json,
  playground_agent_skills_value: @catalog.to_h { |entry| [entry.token, entry.required_skills.map(&:token)] }.to_json
} do %>
  <%= hidden_field_tag :choices, "1" %>

  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
  <%= render FlatPack::Select::Component.new(
    name: "agent",
    label: "Agent",
    options: @agent_options,
    value: @form.agent,
    required: true
  ) %>

  <%= render FlatPack::Select::Component.new(
    name: "profile",
    label: "Profile",
    options: RecordingStudioAgents::Profiles::NAMES.map { |name| [ RecordingStudioAgents::Profiles.label(name), name.to_s ] },
    value: @form.profile,
    required: true
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "goal",
    label: "Instruction",
    value: @form.goal,
    required: true,
    rows: 4
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "context",
    label: "Context",
    value: @form.context,
    rows: 4
  ) %>

  <div data-playground-skills data-playground-agent-target="skills">
    <%= render FlatPack::Select::Component.new(
      name: "skills",
      label: "Skills",
      options: @skill_options.map { |skill| [ skill.name, skill.token ] },
      value: @form.skills,
      multiple: true,
      searchable: true,
      placeholder: "No skills"
    ) %>
  </div>

  <% @catalog.each do |entry| %>
    <% next if entry.tools.empty? %>
    <% active = entry.token == @form.agent %>
    <fieldset data-playground-tools="<%= entry.token %>"<% unless active %> disabled hidden<% end %>>
      <%= render FlatPack::Select::Component.new(
        name: "tools",
        label: "Tools",
        options: entry.tools.map { |tool| [ tool.name, tool.token ] },
        value: active ? @form.tools : entry.tools.map(&:token),
        multiple: true,
        searchable: true,
        placeholder: "No tools",
        disabled: !active
      ) %>
    </fieldset>
  <% end %>

  <%= render FlatPack::Button::Component.new(
    text: "Run",
    style: :primary,
    size: :md,
    type: "submit"
  ) %>
  <% end %>
<% end %>
